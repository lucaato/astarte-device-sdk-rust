{
    "interface_name": "org.astarte-platform.rust.examples.individual-datastream.ServerDatastreamNoTimestamp",
    "version_major": 0,
    "version_minor": 1,
    "type": "datastream",
    "ownership": "server",
    "mappings": [
        {
            "endpoint": "/%{led_id}/enable",
            "type": "boolean",
            "explicit_timestamp": false
        },
        {
            "endpoint": "/%{led_id}/intensity",
            "type": "double",
            "explicit_timestamp": false
        }
    ]
}
